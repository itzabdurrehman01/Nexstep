# NexStep Mobile — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Backend API base URL
# Development (local):   http://192.168.x.x:30001  (use your machine's LAN IP, not localhost)
# Production:            https://api.nexstep.edu.pk
EXPO_PUBLIC_API_URL=http://192.168.1.100:30001

# App environment
EXPO_PUBLIC_ENV=development
