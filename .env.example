# ─────────────────────────────────────────────────────────────────────────────
# NexStep — Frontend Environment Variables
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Copy this to frontend/.env when running standalone.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL used by the Vite dev proxy (default: http://localhost:30001)
VITE_API_URL=http://localhost:30001
